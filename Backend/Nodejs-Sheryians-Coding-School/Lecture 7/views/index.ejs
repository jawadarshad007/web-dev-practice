<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes App</title>
  <link rel="stylesheet" href="stylesheets/index.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
  <h1 class="text-3xl font-bold text-center mt-3">Notes App</h1>
  <div class="main w-full">

    <div class="form p-10">
      <form action="/create" method="post">
        <input type="text" placeholder="title" name="title"
          class="border block border-purple-500 rounded-md px-2 py-1 w-full ">
        <textarea placeholder="Enter your task detail" name="details"
          class="border block border-purple-500 rounded-md px-2 py-1 resize-none mt-2 w-full "></textarea>
        <input type="submit" value="Add Task" class="border border-purple-500 rounded-md px-5 py-2 mt-2 bg-blue-600 ">
      </form>
    </div>

    
    <div class="tasks p-10 flex gap-5 flex-wrap">
      <% if (files.length> 0) { %>
        <% files.forEach((val)=> { %>
          <div class="task min-w-72 px-3 py-4 bg-zinc-800 border border-purple-500 rounded-md">
            <h1 class="text-3xl tracking-tighter">
              <%= val %>
            </h1>
            <a href="./file/<%= val %>" class="text-blue-500 mt-3 inline-block">Read More...</a>
          </div>
          <% }) %>

            <% } else { %>
              <h3 class="text-zinc-400">No tasks yet.</h3>
              <% } %>




    </div>

  </div>
</body>

</html>