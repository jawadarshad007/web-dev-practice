<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>

    <div class="w-full h-full p-10">
        <div class="nav mb-10">
            <a href="/read" class="text-blue-400">Read Users</a>
        </div>
        <h1 class="text-3xl tracking-tighter ">Create User</h1>
        <hr class="mb-2">

        <form action="/create" method="post">
            <input type="text" placeholder="name" name="name" class="px-5 py-2 bg-transparent border-2  border-zinc-600 outline-none rounded-lg">
            <input type="email" placeholder="email" name="email" class="px-5 py-2 bg-transparent border-2  border-zinc-600 outline-none rounded-lg">
            <input type="text" placeholder="image-url" name="imageUrl" class="px-5 py-2 bg-transparent border-2  border-zinc-600 outline-none rounded-lg">
            <input type="submit" value="Create User" class="px-5 py-2 bg-blue-500 rounded-lg ml-3 cursor-pointer">
           
        </form>
    </div> 
</body>
</html>